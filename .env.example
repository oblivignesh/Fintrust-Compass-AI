# FinTrust Compass — Environment Variables
# Copy this file to .env and fill in your values

# Google AI API Key (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=AIzaSyCjzpCWfh9wjwIEh7Hm_jSOy7mft_uI3n8

# Gemini model names
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ChromaDB persistence directory (relative to project root)
CHROMA_PERSIST_DIR=./chroma_db

# Path to knowledge source PDFs
KNOWLEDGE_SOURCE_DIR=./Knowledge_Source

# Chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval settings
RETRIEVAL_K=6

# Phoenix Observability (optional — set to true to enable tracing UI)
ENABLE_PHOENIX_TRACING=true
PHOENIX_PORT=6006
